{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^theengs-gateway/Chart\\.yaml$"],
      "matchStrings": [
        "appVersion:\\s*\"(?<currentValue>v?[\\d.]+)\""
      ],
      "depNameTemplate": "theengs/gateway",
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchDepNames": ["theengs/gateway"],
      "groupName": "theengs-gateway"
    }
  ]
}
